{
  "imports": {
    "#/*": "./src/*"
  },
  "type": "module",
  "scripts": {
    "start:v1": "node dist/server.js",

    "dev": "npx ts-node ./src/server.ts",
    "dev:env": "node -r dotenv/config -r ts-node/register src/server.ts dotenv_config_path=../.env",
    
    "build:dev": "npx tsc -p tsconfig.json",
    "build:prod": "npx tsc -p tsconfig.prod.json",
    
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@opensea/stream-js": "^0.1.3",
    "axios": "^1.7.7",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "inversify": "^6.2.2",
    "inversify-express-utils": "^6.5.0",
    "ioredis": "^5.6.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.0",
    "@types/inversify": "^2.0.32",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^22.13.10",
    "@types/phoenix": "^1.6.5",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitest/ui": "^3.2.4",
    "c8": "^10.1.3",
    "eslint": "^9.22.0",
    "eslint-import-resolver-typescript": "^3.8.4",
    "eslint-plugin-promise": "^7.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
