{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
		"moduleResolution": "bundler",

		"paths": {
			"#/*": ["./src/*"]
		},
		"baseUrl": ".",
		"rootDir": "./src",
		"outDir": "./dist",

		"types": [
			"node",
      "vitest/globals"
		],

		"strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,

		"experimentalDecorators": true,  
    "emitDecoratorMetadata": true
  },
	"include": [
    "src/**/*",
    "src/utils", 
    "src/server.ts", 
    "src/__tests__", 
    "src/application", 
    "src/presentation", 
    "src/infrastructure", 
    "src/di", 
    "src/core", 
    "src/config"
  ],
  "exclude": ["dist", "node_modules"]
}
