{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "node",
    "outDir": "./dist",
    
    "removeComments": true,
    "declaration": false,
    "sourceMap": false
  },
  "exclude": [
    "**/*.test.*", 
    "**/__mocks__/*", 
    "**/__tests__/*",
    "node_modules", 
    "dist"
  ],
  "include": [
    "src/**/*"
  ]
}
